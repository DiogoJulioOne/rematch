<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@color/rm_background">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mensagens" android:textSize="27sp" android:textColor="@color/rm_text" android:textStyle="bold" android:id="@+id/tvTituloMensagens" android:layout_marginTop="16dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Converse sobre retirada, venda, doação e troca." android:textSize="14sp" android:textColor="@color/rm_secondary" android:id="@+id/tvSubtituloMensagens" android:layout_marginTop="7dp"/>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/rm_border"/>
  <androidx.recyclerview.widget.RecyclerView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:id="@+id/recyclerMensagens" android:clipToPadding="false" android:paddingBottom="15dp"/>
</LinearLayout>
