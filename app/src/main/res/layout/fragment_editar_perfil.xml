<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rm_background">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rm_background" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:paddingBottom="24dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Editar perfil" android:textSize="27sp" android:textColor="@color/rm_text" android:textStyle="bold" android:layout_marginTop="18dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Atualize as informações da sua conta." android:textSize="14sp" android:textColor="@color/rm_secondary" android:layout_marginTop="6dp"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:background="@drawable/rm_card" android:orientation="vertical" android:padding="24dp">
        <ImageView android:id="@+id/imgFotoPerfil" android:layout_width="124dp" android:layout_height="124dp" android:layout_gravity="center_horizontal" android:background="@drawable/rm_photo" android:contentDescription="Foto de perfil" android:scaleType="centerCrop"/>
        <Button android:id="@+id/btnSelecionarFotoPerfil" android:layout_width="wrap_content" android:layout_height="54dp" android:layout_marginTop="14dp" android:text="Alterar foto" android:textAllCaps="false" android:textStyle="bold" android:textSize="15sp" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_primary_dark" android:minHeight="54dp" android:elevation="0dp" android:layout_gravity="center_horizontal"/>
      </LinearLayout>
      <EditText android:id="@+id/edtNomePerfil" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="22dp" android:background="@drawable/rm_field" android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:hint="Nome completo" android:inputType="textPersonName"/>
      <EditText android:id="@+id/edtLocalizacaoPerfil" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/rm_field" android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:hint="Cidade / localização" android:inputType="text"/>
      <EditText android:id="@+id/edtDescricaoPerfil" android:layout_width="match_parent" android:layout_height="112dp" android:layout_marginTop="12dp" android:background="@drawable/rm_field" android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:hint="Fale um pouco sobre você" android:inputType="textMultiLine" android:gravity="top|start" android:paddingTop="15dp" android:paddingBottom="14dp"/>
      <Button android:id="@+id/btnSalvarPerfil" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="24dp" android:text="Salvar alterações" android:textAllCaps="false" android:textStyle="bold" android:textSize="15sp" android:backgroundTint="@color/rm_primary" android:textColor="@color/rm_on_primary" android:minHeight="54dp" android:elevation="0dp"/>
      <Button android:id="@+id/btnVoltarPerfil" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:text="Voltar" android:textAllCaps="false" android:textStyle="bold" android:textSize="15sp" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_primary_dark" android:minHeight="54dp" android:elevation="0dp"/>
    </LinearLayout>
  </ScrollView>
  <ImageView android:layout_width="93dp" android:layout_height="78dp" android:src="@drawable/eco_leaf_corner" android:scaleType="fitCenter" android:contentDescription="Ilustração de sustentabilidade" android:layout_gravity="top|right" android:alpha="0.44" android:clickable="false" android:importantForAccessibility="no"/>
</FrameLayout>
