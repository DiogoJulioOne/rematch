<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Explorar" android:textSize="28sp" android:textColor="@color/rm_text" android:textStyle="bold" android:layout_marginTop="21dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Materiais que podem ganhar uma nova vida." android:textSize="14sp" android:textColor="@color/rm_secondary" android:layout_marginTop="5dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp" android:gravity="center_vertical">
    <EditText android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:id="@+id/edtBusca" android:hint="Buscar materiais..." android:background="@drawable/rm_field" android:paddingStart="16dp" android:paddingEnd="12dp" android:textSize="14sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary"/>
    <Button android:layout_width="51dp" android:layout_height="51dp" android:id="@+id/btnBuscar" android:text="⌕" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_primary" android:textColor="@color/rm_on_primary" android:elevation="0dp" android:minHeight="51dp" android:layout_marginStart="8dp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="15dp">
    <Button android:layout_width="0dp" android:layout_height="41dp" android:id="@+id/chipTodos" android:text="Todos" android:textSize="12sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_primary" android:textColor="@color/rm_on_primary" android:elevation="0dp" android:minHeight="41dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:layout_marginStart="3dp"/>
    <Button android:layout_width="0dp" android:layout_height="41dp" android:id="@+id/chipDoacao" android:text="Doação" android:textSize="12sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_primary_dark" android:elevation="0dp" android:minHeight="41dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:layout_marginStart="3dp"/>
    <Button android:layout_width="0dp" android:layout_height="41dp" android:id="@+id/chipTroca" android:text="Troca" android:textSize="12sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_primary_dark" android:elevation="0dp" android:minHeight="41dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:layout_marginStart="3dp"/>
    <Button android:layout_width="0dp" android:layout_height="41dp" android:id="@+id/chipVenda" android:text="Venda" android:textSize="12sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_primary_dark" android:elevation="0dp" android:minHeight="41dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:layout_marginStart="3dp"/>
  </LinearLayout>
  <Button android:layout_width="match_parent" android:layout_height="43dp" android:id="@+id/btnFiltroCategorias" android:text="☷  Categorias" android:textSize="13sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_primary_dark" android:elevation="0dp" android:minHeight="43dp" android:layout_marginTop="11dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Materiais disponíveis" android:textSize="18sp" android:textColor="@color/rm_text" android:textStyle="bold" android:layout_marginTop="19dp"/>
  <ProgressBar android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center_horizontal" android:id="@+id/exploreLoading" android:visibility="gone" android:indeterminateTint="@color/rm_primary"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nenhum material encontrado nesta busca." android:textSize="14sp" android:textColor="@color/rm_secondary" android:gravity="center" android:id="@+id/exploreVazio" android:visibility="gone" android:layout_marginTop="25dp"/>
  <androidx.recyclerview.widget.RecyclerView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:id="@+id/recyclerProdutos" android:paddingTop="9dp" android:paddingBottom="12dp" android:clipToPadding="false"/>
</LinearLayout>
