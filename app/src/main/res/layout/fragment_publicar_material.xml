<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rm_background">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:background="@color/rm_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="34dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Anunciar material" android:textSize="27sp" android:textColor="@color/rm_text" android:textStyle="bold" android:layout_marginTop="20dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dê um novo ciclo ao que você não usa mais." android:textSize="14sp" android:textColor="@color/rm_secondary" android:layout_marginTop="7dp"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/rm_upload" android:padding="15dp" android:layout_marginTop="22dp">
        <ImageView android:layout_width="145dp" android:layout_height="107dp" android:src="@drawable/eco_sprout_box" android:scaleType="fitCenter" android:contentDescription="Ilustração de sustentabilidade" android:layout_gravity="center_horizontal"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Adicionar foto *" android:textSize="17sp" android:textColor="@color/rm_primary_dark" android:textStyle="bold" android:gravity="center" android:layout_marginTop="3dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tire ou selecione uma foto da galeria. Obrigatória para publicar." android:textSize="12sp" android:textColor="@color/rm_secondary" android:gravity="center" android:layout_marginTop="5dp"/>
        <ImageView android:layout_width="150dp" android:layout_height="130dp" android:src="@drawable/eco_sprout_box" android:scaleType="fitCenter" android:id="@+id/imgMaterial" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone" android:contentDescription="Foto selecionada do material"/>
        <Button android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/btnSelecionarFoto" android:text="＋ Selecionar foto" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_primary" android:textColor="@color/rm_on_primary" android:elevation="0dp" android:minHeight="52dp" android:layout_marginTop="12dp"/>
      </LinearLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Detalhes do material" android:textSize="18sp" android:textColor="@color/rm_text" android:textStyle="bold" android:layout_marginTop="21dp" android:layout_marginBottom="12dp"/>
      <EditText android:layout_width="match_parent" android:layout_height="54dp" android:id="@+id/edtMaterial" android:hint="Título do material *" android:inputType="text" android:background="@drawable/rm_field" android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary"/>
      <EditText android:layout_width="match_parent" android:layout_height="100dp" android:id="@+id/edtDescricaoMaterial" android:hint="Descrição *" android:inputType="textMultiLine" android:background="@drawable/rm_field" android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:gravity="top|start" android:layout_marginTop="12dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Categoria *" android:textSize="13sp" android:textColor="@color/rm_secondary" android:textStyle="bold" android:layout_marginTop="15dp" android:layout_marginBottom="7dp"/>
      <Spinner android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/spinnerCategoria" android:background="@drawable/rm_field" android:paddingStart="12dp" android:paddingEnd="12dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Modalidade *" android:textSize="13sp" android:textColor="@color/rm_secondary" android:textStyle="bold" android:layout_marginTop="15dp" android:layout_marginBottom="7dp"/>
      <Spinner android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/spinnerModalidade" android:background="@drawable/rm_field" android:paddingStart="12dp" android:paddingEnd="12dp"/>
      <EditText android:layout_width="match_parent" android:layout_height="54dp" android:id="@+id/edtPrecoMaterial" android:hint="Preço em reais (R$) *" android:inputType="numberDecimal" android:background="@drawable/rm_field" android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:layout_marginTop="12dp" android:visibility="gone"/>
      <EditText android:layout_width="match_parent" android:layout_height="54dp" android:id="@+id/edtAceitaTroca" android:hint="O que você gostaria de receber?" android:inputType="text" android:background="@drawable/rm_field" android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:layout_marginTop="12dp" android:visibility="gone"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
        <EditText android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:id="@+id/edtQuantidade" android:hint="Quantidade *" android:inputType="number" android:background="@drawable/rm_field" android:paddingStart="12dp" android:paddingEnd="8dp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:textSize="14sp"/>
        <EditText android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginStart="6dp" android:id="@+id/edtEstado" android:hint="Condição *" android:inputType="text" android:background="@drawable/rm_field" android:paddingStart="12dp" android:paddingEnd="8dp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:textSize="14sp"/>
      </LinearLayout>
      <EditText android:layout_width="match_parent" android:layout_height="54dp" android:id="@+id/edtLocalizacaoMaterial" android:hint="Cidade ou localização *" android:inputType="text" android:background="@drawable/rm_field" android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:layout_marginTop="12dp"/>
      <Button android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/btnPublicar" android:text="♧  Publicar anúncio" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_primary" android:textColor="@color/rm_on_primary" android:elevation="0dp" android:minHeight="52dp" android:layout_marginTop="24dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ao publicar, você ajuda a reduzir o desperdício." android:textSize="12sp" android:textColor="@color/rm_secondary" android:gravity="center" android:layout_marginTop="10dp"/>
    </LinearLayout>
  </ScrollView>
  <ImageView android:layout_width="118dp" android:layout_height="106dp" android:src="@drawable/eco_leaf_corner" android:scaleType="fitCenter" android:contentDescription="Ilustração de sustentabilidade" android:layout_gravity="top|right" android:importantForAccessibility="no" android:alpha="0.86" android:clickable="false"/>
</FrameLayout>
