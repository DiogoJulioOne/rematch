<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rm_background">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:background="@color/rm_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="26dp" android:paddingEnd="26dp" android:paddingBottom="42dp">
      <ImageView android:layout_width="140dp" android:layout_height="135dp" android:src="@drawable/eco_recycle" android:scaleType="fitCenter" android:contentDescription="Ilustração de sustentabilidade" android:layout_gravity="center_horizontal" android:layout_marginTop="40dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ReMatch" android:textSize="35sp" android:textColor="@color/rm_primary_dark" android:textStyle="bold" android:gravity="center" android:layout_marginTop="0dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Acesse sua conta" android:textSize="15sp" android:textColor="@color/rm_secondary" android:gravity="center" android:layout_marginTop="4dp"/>
      <Space android:layout_width="1dp" android:layout_height="34dp"/>
      <EditText android:layout_width="match_parent" android:layout_height="54dp" android:id="@+id/edtEmail" android:hint="E-mail" android:inputType="textEmailAddress" android:background="@drawable/rm_field" android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary"/>
      <EditText android:layout_width="match_parent" android:layout_height="54dp" android:id="@+id/edtSenha" android:hint="Senha" android:inputType="textPassword" android:background="@drawable/rm_field" android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:layout_marginTop="13dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Esqueci minha senha" android:textSize="14sp" android:textColor="@color/rm_primary_dark" android:textStyle="bold" android:gravity="end" android:layout_marginTop="14dp" android:id="@+id/tvEsqueciSenha"/>
      <Button android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/btnEntrar" android:text="Entrar" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_primary" android:textColor="@color/rm_on_primary" android:elevation="0dp" android:minHeight="52dp" android:layout_marginTop="23dp"/>
      <Space android:layout_width="1dp" android:layout_height="26dp"/>
      <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/rm_border"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ainda não tem uma conta? Cadastrar" android:textSize="14sp" android:textColor="@color/rm_primary_dark" android:textStyle="bold" android:gravity="center" android:layout_marginTop="20dp" android:id="@+id/tvCadastro"/>
    </LinearLayout>
  </ScrollView>
  <ImageView android:layout_width="118dp" android:layout_height="106dp" android:src="@drawable/eco_leaf_corner" android:scaleType="fitCenter" android:contentDescription="Ilustração de sustentabilidade" android:layout_gravity="top|right" android:importantForAccessibility="no" android:alpha="0.86" android:clickable="false"/>
  <ImageView android:layout_width="96dp" android:layout_height="88dp" android:src="@drawable/eco_leaf_corner" android:scaleType="fitCenter" android:contentDescription="Ilustração de sustentabilidade" android:layout_gravity="bottom|left" android:rotation="180" android:importantForAccessibility="no" android:alpha="0.65" android:clickable="false"/>
</FrameLayout>
