<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="5dp" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/rm_card">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <ImageView android:layout_width="match_parent" android:layout_height="144dp" android:src="@drawable/eco_sprout_box" android:scaleType="centerCrop" android:id="@+id/imgProduto" android:contentDescription="Foto do material anunciado"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Material reutilizável" android:textSize="14sp" android:textColor="@color/rm_text" android:textStyle="bold" android:id="@+id/tvTituloProduto" android:maxLines="2" android:ellipsize="end"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📍 Localização" android:textSize="12sp" android:textColor="@color/rm_secondary" android:id="@+id/tvLocalizacaoProduto" android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="end"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="♻ Doação" android:textSize="12sp" android:textColor="@color/rm_primary_dark" android:textStyle="bold" android:id="@+id/tvModalidadeProduto" android:layout_marginTop="9dp"/>
      <Button android:layout_width="match_parent" android:layout_height="39dp" android:id="@+id/btnVerProduto" android:text="Ver detalhes  ›" android:textSize="12sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_primary_dark" android:elevation="0dp" android:minHeight="39dp" android:layout_marginTop="9dp"/>
    </LinearLayout>
  </LinearLayout>
</androidx.cardview.widget.CardView>
