<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rm_background">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:background="@color/rm_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="19dp" android:paddingEnd="19dp" android:paddingBottom="30dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Detalhes do material" android:textSize="22sp" android:textColor="@color/rm_text" android:textStyle="bold" android:layout_marginTop="15dp"/>
      <ImageView android:layout_width="match_parent" android:layout_height="238dp" android:id="@+id/imgProduto" android:layout_marginTop="14dp" android:src="@drawable/eco_sprout_box" android:scaleType="centerCrop" android:contentDescription="Foto do material"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Título do material" android:textSize="25sp" android:textColor="@color/rm_text" android:textStyle="bold" android:id="@+id/tvTitulo" android:layout_marginTop="15dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="♻ Modalidade" android:textSize="14sp" android:textColor="@color/rm_primary_dark" android:textStyle="bold" android:layout_marginTop="10dp" android:id="@+id/tvModalidade"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📍 Localização" android:textSize="13sp" android:textColor="@color/rm_secondary" android:layout_marginTop="9dp" android:id="@+id/tvLocalizacao"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/rm_card" android:padding="18dp" android:layout_marginTop="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Informações do material" android:textSize="17sp" android:textColor="@color/rm_primary_dark" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Categoria" android:textSize="14sp" android:textColor="@color/rm_text" android:id="@+id/tvCategoria" android:layout_marginTop="13dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Condição" android:textSize="14sp" android:textColor="@color/rm_text" android:id="@+id/tvEstado" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quantidade" android:textSize="14sp" android:textColor="@color/rm_text" android:id="@+id/tvQuantidade" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="@color/rm_text" android:id="@+id/tvPreco" android:layout_marginTop="8dp" android:visibility="gone"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="@color/rm_text" android:id="@+id/tvTrocaPor" android:layout_marginTop="8dp" android:visibility="gone"/>
      </LinearLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Descrição" android:textSize="18sp" android:textColor="@color/rm_text" android:textStyle="bold" android:layout_marginTop="21dp" android:layout_marginBottom="12dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Descrição do material" android:textSize="14sp" android:textColor="@color/rm_secondary" android:id="@+id/tvDescricao" android:background="@drawable/rm_card" android:padding="16dp" android:lineSpacingExtra="3dp"/>
      <Button android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/btnTenhoInteresse" android:text="Solicitar" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_primary" android:textColor="@color/rm_on_primary" android:elevation="0dp" android:minHeight="52dp" android:layout_marginTop="23dp"/>
      <Button android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/btnVoltar" android:text="← Voltar" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_primary_dark" android:elevation="0dp" android:minHeight="52dp" android:layout_marginTop="10dp"/>
    </LinearLayout>
  </ScrollView>
  <ImageView android:layout_width="118dp" android:layout_height="106dp" android:src="@drawable/eco_leaf_corner" android:scaleType="fitCenter" android:contentDescription="Ilustração de sustentabilidade" android:layout_gravity="top|right" android:importantForAccessibility="no" android:alpha="0.86" android:clickable="false"/>
</FrameLayout>
