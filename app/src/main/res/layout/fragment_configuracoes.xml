<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rm_background">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rm_background" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:paddingBottom="24dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Configurações" android:textSize="27sp" android:textColor="@color/rm_text" android:textStyle="bold" android:layout_marginTop="18dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Controle sua experiência no ReMatch." android:textSize="14sp" android:textColor="@color/rm_secondary" android:layout_marginTop="6dp"/>
      <Button android:id="@+id/btnNotificacoes" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="15dp" android:text="♧  Notificações  ›" android:textAllCaps="false" android:textStyle="bold" android:textSize="15sp" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_primary_dark" android:minHeight="54dp" android:elevation="0dp"/>
      <Button android:id="@+id/btnPrivacidade" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="15dp" android:text="♙  Privacidade  ›" android:textAllCaps="false" android:textStyle="bold" android:textSize="15sp" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_primary_dark" android:minHeight="54dp" android:elevation="0dp"/>
      <Button android:id="@+id/btnAjuda" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="15dp" android:text="ⓘ  Central de ajuda  ›" android:textAllCaps="false" android:textStyle="bold" android:textSize="15sp" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_primary_dark" android:minHeight="54dp" android:elevation="0dp"/>
      <Button android:id="@+id/btnTermos" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="15dp" android:text="▤  Termos de uso  ›" android:textAllCaps="false" android:textStyle="bold" android:textSize="15sp" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_primary_dark" android:minHeight="54dp" android:elevation="0dp"/>
      <Button android:id="@+id/btnVoltarPerfil" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="28dp" android:text="←  Voltar ao perfil" android:textAllCaps="false" android:textStyle="bold" android:textSize="15sp" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_primary_dark" android:minHeight="54dp" android:elevation="0dp"/>
      <Button android:id="@+id/btnSair" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:text="Sair da conta" android:textAllCaps="false" android:textStyle="bold" android:textSize="15sp" android:backgroundTint="@color/rm_tile" android:textColor="@color/rm_danger" android:minHeight="54dp" android:elevation="0dp"/>
    </LinearLayout>
  </ScrollView>
  <ImageView android:layout_width="93dp" android:layout_height="78dp" android:src="@drawable/eco_leaf_corner" android:scaleType="fitCenter" android:contentDescription="Ilustração de sustentabilidade" android:layout_gravity="top|right" android:alpha="0.44" android:clickable="false" android:importantForAccessibility="no"/>
</FrameLayout>
