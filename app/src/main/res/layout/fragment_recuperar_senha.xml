<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rm_background">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:background="@color/rm_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="25dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✉" android:textSize="78sp" android:textColor="@color/rm_primary_dark" android:gravity="center" android:layout_marginTop="65dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recuperar senha" android:textSize="28sp" android:textColor="@color/rm_text" android:textStyle="bold" android:gravity="center" android:layout_marginTop="15dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Informe o e-mail da sua conta para receber o link de redefinição." android:textSize="15sp" android:textColor="@color/rm_secondary" android:gravity="center" android:layout_marginTop="18dp"/>
      <EditText android:layout_width="match_parent" android:layout_height="54dp" android:id="@+id/edtRecuperarEmail" android:hint="E-mail" android:inputType="textEmailAddress" android:background="@drawable/rm_field" android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:layout_marginTop="32dp"/>
      <Button android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/btnRecuperarSenha" android:text="Enviar link" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_primary" android:textColor="@color/rm_on_primary" android:elevation="0dp" android:minHeight="52dp" android:layout_marginTop="24dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Voltar para entrar" android:textSize="14sp" android:textColor="@color/rm_primary_dark" android:textStyle="bold" android:gravity="center" android:layout_marginTop="20dp" android:id="@+id/tvRecuperarVoltar"/>
    </LinearLayout>
  </ScrollView>
  <ImageView android:layout_width="118dp" android:layout_height="106dp" android:src="@drawable/eco_leaf_corner" android:scaleType="fitCenter" android:contentDescription="Ilustração de sustentabilidade" android:layout_gravity="top|right" android:importantForAccessibility="no" android:alpha="0.86" android:clickable="false"/>
  <ImageView android:layout_width="96dp" android:layout_height="88dp" android:src="@drawable/eco_leaf_corner" android:scaleType="fitCenter" android:contentDescription="Ilustração de sustentabilidade" android:layout_gravity="bottom|left" android:rotation="180" android:importantForAccessibility="no" android:alpha="0.65" android:clickable="false"/>
</FrameLayout>
