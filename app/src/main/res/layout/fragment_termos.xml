<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rm_background">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rm_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:text="Termos de Uso" android:textColor="@color/rm_text" android:textSize="28sp" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Conheça as condições de utilização do ReMatch." android:textColor="@color/rm_secondary" android:textSize="15sp"/>
      <!-- CONTEÚDO -->
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:layout_marginBottom="30dp" android:background="@drawable/rm_card" android:elevation="2dp" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Sobre o ReMatch" android:textColor="@color/rm_primary" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="O ReMatch é uma plataforma desenvolvida para facilitar a conexão entre usuários interessados em anunciar, encontrar e trocar materiais, incentivando o reaproveitamento e práticas mais sustentáveis." android:textColor="@color/rm_text" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="2. Cadastro e conta" android:textColor="@color/rm_primary" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="O usuário é responsável pelas informações fornecidas durante o cadastro e pela utilização de sua conta. As informações cadastradas devem ser verdadeiras e mantidas atualizadas." android:textColor="@color/rm_text" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="3. Anúncios e materiais" android:textColor="@color/rm_primary" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Cada usuário é responsável pelos materiais e pelas informações presentes em seus anúncios. Não devem ser publicados conteúdos falsos, enganosos, ilegais ou que violem direitos de terceiros." android:textColor="@color/rm_text" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="4. Negociações e comunicação" android:textColor="@color/rm_primary" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="O ReMatch pode facilitar o contato entre usuários interessados em negociar materiais por meio de mensagens. Os usuários são responsáveis pelas conversas, acordos e combinações realizados entre si." android:textColor="@color/rm_text" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="5. Condutas proibidas" android:textColor="@color/rm_primary" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Não é permitido utilizar o ReMatch para praticar fraudes, ameaçar ou assediar outros usuários, divulgar conteúdo ilegal, utilizar informações falsas ou realizar atividades que prejudiquem o funcionamento da plataforma." android:textColor="@color/rm_text" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="6. Privacidade" android:textColor="@color/rm_primary" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="As informações dos usuários devem ser utilizadas apenas para as finalidades relacionadas ao funcionamento do ReMatch, respeitando as configurações de privacidade disponíveis na plataforma." android:textColor="@color/rm_text" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="7. Responsabilidades" android:textColor="@color/rm_primary" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="O ReMatch atua como uma plataforma de conexão entre usuários. Cada usuário deve avaliar com cuidado as informações, materiais e acordos realizados com outras pessoas por meio da plataforma." android:textColor="@color/rm_text" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="8. Alterações nos termos" android:textColor="@color/rm_primary" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Estes termos poderão ser atualizados conforme novas funcionalidades forem adicionadas ou mudanças forem realizadas no ReMatch." android:textColor="@color/rm_text" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="9. Aceitação dos termos" android:textColor="@color/rm_primary" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ao utilizar o ReMatch, o usuário declara estar ciente destes Termos de Uso e concorda em utilizar a plataforma de maneira responsável." android:textColor="@color/rm_text" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
  <ImageView android:layout_width="93dp" android:layout_height="78dp" android:src="@drawable/eco_leaf_corner" android:scaleType="fitCenter" android:contentDescription="Ilustração de sustentabilidade" android:layout_gravity="top|right" android:alpha="0.44" android:clickable="false" android:importantForAccessibility="no"/>
</FrameLayout>
