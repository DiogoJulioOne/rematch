<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/rm_background">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:background="@color/rm_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="25dp" android:paddingEnd="25dp" android:paddingBottom="45dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Criar conta" android:textSize="28sp" android:textColor="@color/rm_text" android:textStyle="bold" android:gravity="center" android:layout_marginTop="56dp" android:id="@+id/tvTituloCadastro"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Faça parte de uma comunidade que reutiliza." android:textSize="14sp" android:textColor="@color/rm_secondary" android:gravity="center" android:layout_marginTop="8dp" android:id="@+id/tvSubtituloCadastro"/>
      <Space android:layout_width="1dp" android:layout_height="30dp"/>
      <EditText android:layout_width="match_parent" android:layout_height="54dp" android:id="@+id/edtNome" android:hint="Nome completo" android:inputType="textPersonName" android:background="@drawable/rm_field" android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary"/>
      <EditText android:layout_width="match_parent" android:layout_height="54dp" android:id="@+id/edtEmailCadastro" android:hint="E-mail" android:inputType="textEmailAddress" android:background="@drawable/rm_field" android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:layout_marginTop="12dp"/>
      <EditText android:layout_width="match_parent" android:layout_height="54dp" android:id="@+id/edtSenhaCadastro" android:hint="Senha" android:inputType="textPassword" android:background="@drawable/rm_field" android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:layout_marginTop="12dp"/>
      <EditText android:layout_width="match_parent" android:layout_height="54dp" android:id="@+id/edtConfirmarSenha" android:hint="Confirmar senha" android:inputType="textPassword" android:background="@drawable/rm_field" android:paddingStart="15dp" android:paddingEnd="15dp" android:textSize="15sp" android:textColor="@color/rm_text" android:textColorHint="@color/rm_secondary" android:layout_marginTop="12dp"/>
      <CheckBox android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/checkTermosCadastro" android:text="Li e aceito os Termos de Uso e a Política de Privacidade" android:textSize="13sp" android:textColor="@color/rm_primary_dark" android:buttonTint="@color/rm_primary" android:layout_marginTop="19dp"/>
      <Button android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/btnCadastrar" android:text="Cadastrar" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:backgroundTint="@color/rm_primary" android:textColor="@color/rm_on_primary" android:elevation="0dp" android:minHeight="52dp" android:layout_marginTop="22dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Já possui uma conta? Entrar" android:textSize="14sp" android:textColor="@color/rm_primary_dark" android:textStyle="bold" android:id="@+id/tvVoltarLogin" android:gravity="center" android:layout_marginTop="24dp"/>
    </LinearLayout>
  </ScrollView>
  <ImageView android:layout_width="118dp" android:layout_height="106dp" android:src="@drawable/eco_leaf_corner" android:scaleType="fitCenter" android:contentDescription="Ilustração de sustentabilidade" android:layout_gravity="top|right" android:importantForAccessibility="no" android:alpha="0.86" android:clickable="false"/>
  <ImageView android:layout_width="96dp" android:layout_height="88dp" android:src="@drawable/eco_leaf_corner" android:scaleType="fitCenter" android:contentDescription="Ilustração de sustentabilidade" android:layout_gravity="bottom|left" android:rotation="180" android:importantForAccessibility="no" android:alpha="0.65" android:clickable="false"/>
</FrameLayout>
